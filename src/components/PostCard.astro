---
import { type Post, formatDate } from '../lib/directus';

interface Props { post: Post }
const { post } = Astro.props;
const cat = post.category && typeof post.category === 'object' ? post.category : null;
---
<div class="card">
  {post.thumbnail && (
    <div class="card-image">
      <a href={`/archives/${post.slug}/`} class="image is-7by1">
        <img class="thumbnail" src={post.thumbnail} loading="lazy" alt={post.title} />
      </a>
    </div>
  )}
  <div class="card-content article article-item">
    <div class="level article-meta is-size-7 is-uppercase is-mobile is-overflow-x-auto">
      <div class="level-left">
        <time class="level-item has-text-grey" datetime={formatDate(post.published_at)}>{formatDate(post.published_at)}</time>
        {cat && (
          <div class="level-item article-cat">
            {cat.parent && typeof cat.parent === 'object' && (
              <>
                <a class="has-link-grey" href={`/category/${(cat.parent as any).slug}/`}>{(cat.parent as any).name}</a>
                <span class="cat-sep">/</span>
              </>
            )}
            <a class="has-link-grey" href={`/category/${cat.slug}/`}>{cat.name}</a>
          </div>
        )}
      </div>
    </div>
    <h1 class="title is-size-3 is-size-4-mobile has-text-weight-normal">
      <a class="has-link-black-ter" href={`/archives/${post.slug}/`}>{post.title}</a>
    </h1>
    <div class="content">{post.excerpt}</div>
    <div class="level is-mobile">
      <div class="level-start">
        <div class="level-item">
          <a class="button is-size-7 is-light" href={`/archives/${post.slug}/`}>阅读全文</a>
        </div>
      </div>
    </div>
  </div>
</div>
