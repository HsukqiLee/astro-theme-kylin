---
import type { CategoryNode } from '../lib/taxonomy';
interface Props { nodes: CategoryNode[] }
const { nodes } = Astro.props;
---
{nodes.length > 0 && (
  <ul class="menu-list">
    {nodes.map(node => (
      <li>
        <a class="level is-marginless" href={`/category/${node.slug}/`}>
          <span class="level-start"><span class="level-item">{node.name}</span></span>
          <span class="level-end"><span class="level-item tag">{node.count}</span></span>
        </a>
        <Astro.self nodes={node.children} />
      </li>
    ))}
  </ul>
)}
