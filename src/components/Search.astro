---
---
<div class="searchbox" id="searchbox">
  <div class="searchbox-container">
    <div class="searchbox-header">
      <div class="searchbox-input-wrapper">
        <input type="text" class="searchbox-input" id="search-input" placeholder="输入关键词搜索…" aria-label="搜索文章" maxlength="200" autocomplete="off" />
      </div>
      <a class="searchbox-close" href="javascript:;" id="search-close" aria-label="关闭搜索">&times;</a>
    </div>
    <div class="searchbox-body">
      <div class="searchbox-result-wrapper">
        <div class="ins-section-container">
          <section class="ins-section">
            <header class="ins-section-header">搜索结果</header>
            <div id="search-results" aria-live="polite"></div>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>
