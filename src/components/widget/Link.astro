---
import { siteConfig } from '../../lib/config';

function domain(url: string): string {
  try { return new URL(url).hostname; } catch { return ''; }
}
---
{siteConfig.links.length > 0 && (
  <div class="card widget">
    <div class="card-content">
      <div class="menu">
        <h3 class="menu-label">友链</h3>
        <ul class="menu-list">
          {siteConfig.links.map((link) => (
            <li>
              <a class="level is-mobile" href={link.url} target="_blank">
                <span class="level-left"><span class="level-item">{link.name}</span></span>
                {domain(link.url) && (
                  <span class="level-right"><span class="level-item tag">{domain(link.url)}</span></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
)}
