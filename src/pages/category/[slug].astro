---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { directus, postCardFields, type Post, type Category } from '../../lib/directus';
import { readItems, aggregate } from '@directus/sdk';
import { siteConfig } from '../../lib/config';

const slug = Astro.params.slug;
if (!slug) return Astro.rewrite('/404');
const cats = await directus.request(readItems('categories', { filter: { slug: { _eq: slug } }, limit: 1, fields: ['id', 'name', 'slug'] }));
const cat = (cats as Category[])[0];
if (!cat) return Astro.rewrite('/404');

// Include all descendants, not only the first level.
const categories = await directus.request(readItems('categories', { limit: -1, fields: ['id', 'parent'] }));
const catIds = new Set([cat.id]);
for (let changed = true; changed;) {
  changed = false;
  for (const child of categories) {
    const parent = typeof child.parent === 'object' ? child.parent?.id : child.parent;
    if (parent && catIds.has(parent) && !catIds.has(child.id)) {
      catIds.add(child.id);
      changed = true;
    }
  }
}
const filter = { status: { _eq: 'published' }, type: { _eq: 'post' }, categories: { categories_id: { _in: [...catIds] } } } as const;

const PER_PAGE = 10;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const posts = (await directus.request(
  readItems('posts', {
    fields: postCardFields,
    filter,
    sort: ['-published_at'],
    page,
    limit: PER_PAGE
  })
)) as Post[];

let total = posts.length;
try {
  const cnt = await directus.request(aggregate('posts', { query: { filter }, aggregate: { count: ['id'] } }));
  total = Number((cnt as any[])[0]?.count?.id ?? posts.length);
} catch { /* ignore */ }
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
---
<BaseLayout title={`${cat.name} - ${siteConfig.title}`}>
  <div class="card">
    <div class="card-content">
      <nav class="breadcrumb" aria-label="breadcrumbs">
        <ul>
          <li><a href="/">首页</a></li>
          <li><a href="/categories/">分类</a></li>
          <li class="is-active"><a href="#" aria-current="page">{cat.name}</a></li>
        </ul>
      </nav>
    </div>
  </div>
  {posts.map((post) => <PostCard post={post} />)}
  <Pagination page={page} pages={pages} baseUrl={`/category/${cat.slug}/`} />
</BaseLayout>
