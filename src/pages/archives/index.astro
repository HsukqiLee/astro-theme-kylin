---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { directus, postCardFields, type Post, formatDate } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { siteConfig } from '../../lib/config';

const month = Astro.url.searchParams.get('m');
const posts = (await directus.request(
  readItems('posts', {
    fields: postCardFields,
    filter: { status: { _eq: 'published' }, type: { _eq: 'post' } },
    sort: ['-published_at'],
    limit: -1
  })
)) as Post[];

const years = new Map<string, Post[]>();
for (const p of posts) {
  if (!p.published_at || (month && p.published_at.substring(0, 7) !== month)) continue;
  const y = p.published_at.substring(0, 4);
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(p);
}
const yearKeys = [...years.keys()].sort((a, b) => b.localeCompare(a));
---
<BaseLayout title={`归档 - ${siteConfig.title}`}>
  {yearKeys.map((year) => (
    <div class="card widget">
      <div class="card-content">
        <h3 class="tag is-link">{year}</h3>
        <div class="timeline">
          {years.get(year)!.map((p) => {
            const cat = p.category && typeof p.category === 'object' ? p.category : null;
            return (
              <article class="media">
                {p.thumbnail && (
                  <a href={`/archives/${p.slug}/`} class="media-left">
                    <p class="image is-64x64">
                      <img class="thumbnail" loading="lazy" src={p.thumbnail} alt={p.title} />
                    </p>
                  </a>
                )}
                <div class="media-content">
                  <div class="content">
                    <time class="has-text-grey is-size-7 is-block is-uppercase" datetime={formatDate(p.published_at)}>{formatDate(p.published_at)}</time>
                    <a href={`/archives/${p.slug}/`} class="has-link-black-ter is-size-6">{p.title}</a>
                    {cat && (
                      <div class="level article-meta is-mobile">
                        <div class="level-left">
                          <div class="level-item is-size-7 is-uppercase article-cat">
                            {cat.parent && typeof cat.parent === 'object' && (
                              <>
                                <a class="has-link-grey" href={`/category/${(cat.parent as any).slug}/`}>{(cat.parent as any).name}</a>
                                <span class="cat-sep">/</span>
                              </>
                            )}
                            <a class="has-link-grey" href={`/category/${cat.slug}/`}>{cat.name}</a>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  ))}
</BaseLayout>
